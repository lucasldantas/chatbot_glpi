# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres_master_password
EVOLUTION_DB_PASSWORD=evolution_db_password
CHATWOOT_DB_PASSWORD=chatwoot_db_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password

# ─── Evolution API ────────────────────────────────────────────────────────────
EVOLUTION_API_KEY=your_evolution_api_key_here
# Nome da instância WhatsApp criada na Evolution API (ex: suporte)
EVOLUTION_INSTANCE=suporte

# ─── GLPI ─────────────────────────────────────────────────────────────────────
GLPI_URL=https://glpi.suaempresa.com.br
# App-Token gerado em: Configuração > Geral > API
GLPI_APP_TOKEN=your_glpi_app_token_here
# User-Token de uma conta de serviço (service account) com permissão de técnico
GLPI_USER_TOKEN=your_glpi_user_token_here

# ─── ChatWoot ─────────────────────────────────────────────────────────────────
CHATWOOT_FRONTEND_URL=http://localhost:3001
# API Token de acesso: Configurações do Perfil > Tokens de Acesso
CHATWOOT_API_TOKEN=your_chatwoot_api_token_here
# ID da conta (número na URL após /app/accounts/)
CHATWOOT_ACCOUNT_ID=1
# ID da inbox WhatsApp (criada via Evolution API)
CHATWOOT_INBOX_ID=1
# Secret para validar webhooks vindos do ChatWoot
CHATWOOT_WEBHOOK_SECRET=chatwoot_webhook_secret_here

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Bot ──────────────────────────────────────────────────────────────────────
# Tempo (segundos) que a sessão fica ativa sem interação do usuário
SESSION_TTL_SECONDS=3600

# ─── ChatWoot Secret para assinar webhooks ────────────────────────────────────
CHATWOOT_SECRET_KEY=chatwoot_rails_secret_key_base_64_chars_minimum
