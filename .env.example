# ─── Identidade do Bot ────────────────────────────────────────────────────────
# Personalize para cada cliente/empresa
BOT_COMPANY_NAME="Minha Empresa"
BOT_NAME="Assistente"
BOT_SUPPORT_TEAM="Suporte TI"

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD="senha_postgres_aqui"
EVOLUTION_DB_PASSWORD="senha_evolution_db_aqui"
CHATWOOT_DB_PASSWORD="senha_chatwoot_db_aqui"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD="senha_redis_aqui"
REDIS_PASSWORD_ENCODED="senha_redis_aqui"   # @ → %40, : → %3A, / → %2F, # → %23

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
EVOLUTION_API_KEY="sua_api_key_evolution_minimo_20_chars"
EVOLUTION_INSTANCE="suporte"

# ─── GLPI ─────────────────────────────────────────────────────────────────────
GLPI_URL="https://glpi.suaempresa.com.br"
GLPI_APP_TOKEN="app_token_do_glpi"
GLPI_USER_TOKEN="user_token_da_conta_servico"
GLPI_DEFAULT_CATEGORY_ID="0"
GLPI_ONBOARDING_CATEGORY_ID="0"

# ─── ChatWoot ─────────────────────────────────────────────────────────────────
CHATWOOT_FRONTEND_URL="http://localhost:3001"
CHATWOOT_ACCOUNT_NAME="Suporte TI"
CHATWOOT_ADMIN_NAME="Administrador"
CHATWOOT_ADMIN_EMAIL="admin@suaempresa.com"
CHATWOOT_ADMIN_PASSWORD="senha_admin_chatwoot"
CHATWOOT_SECRET_KEY="string_aleatoria_minimo_64_chars_gere_com_openssl_rand_hex_64"
CHATWOOT_API_TOKEN="token_obtido_apos_primeiro_login"
CHATWOOT_ACCOUNT_ID="1"
CHATWOOT_INBOX_ID="1"
CHATWOOT_WEBHOOK_SECRET="webhook_secret_aqui"

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."
CLAUDE_MODEL="claude-sonnet-4-6"

# ─── JumpCloud (opcional) ─────────────────────────────────────────────────────
# false = valida apenas pelo GLPI | true = JumpCloud + GLPI + CPF
JUMPCLOUD_ENABLED="false"
JUMPCLOUD_API_KEY=""

# ─── Bot ──────────────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS="3600"
CSAT_SCALE="5"
